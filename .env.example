# Copy to .env.local for local development. Never commit real values.

# Data backend: "memory" (default, seeded, no credentials) or "firestore"
DATA_BACKEND=memory

# Vertex AI (Gemini). Leave GOOGLE_CLOUD_PROJECT empty to use the
# deterministic rule-based fallbacks instead of calling Gemini.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash

# HMAC key for signed session cookies. Set a long random string in production
# (on Cloud Run, mount it from Secret Manager).
SESSION_SECRET=

# QR_SECRET is not used: each site carries its own rotating-QR secret
# (Site.qrSecret in the data store).
