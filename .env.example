# FairShift environment variables. Copy to .env.local for local overrides.
# Nothing is required to run locally: without MONGODB_URI the app uses seeded in-memory data,
# and without GEMINI_API_KEY the AI explanations fall back to rule-based text.

# MongoDB Atlas connection string (Vercel env var / Marketplace integration). Omit for in-memory demo data.
MONGODB_URI=
# Database name inside the cluster (default: fairshift)
MONGODB_DB=fairshift
# Force the in-memory store even when MONGODB_URI is set (memory|mongodb)
DATA_BACKEND=

# Signs session cookies and derives QR / passport keys. REQUIRED in production (any long random string).
SESSION_SECRET=

# Google Gemini API key (server-only). Omit to use the rule-based fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
